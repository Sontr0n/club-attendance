# Local dev: SQLite file (relative to project root)
# Production: libSQL / Turso URL, e.g. libsql://your-db.turso.io
DATABASE_URL="file:./prisma/dev.db"

# Only set for Turso (leave blank for local file DB)
TURSO_AUTH_TOKEN=""

# Admin password (single-admin app)
ADMIN_PASSWORD="change-me"

# Used to sign the admin session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="generate-a-random-secret"

# Slack — create a bot at https://api.slack.com/apps with chat:write and users:read scopes
SLACK_BOT_TOKEN="xoxb-..."

# Google Calendar — service account JSON (paste the entire JSON object on one line)
# OR set GOOGLE_APPLICATION_CREDENTIALS to a file path
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_CALENDAR_ID=""

# Optional: prefix used to classify calendar events as socials vs meetings.
# Events whose title starts with this prefix become socials. Everything else becomes a general meeting.
SOCIAL_EVENT_PREFIX="[Social]"
